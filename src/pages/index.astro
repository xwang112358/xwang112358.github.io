---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import PubItem from '../components/PubItem.astro';
import { site, links, featured, news } from '../data/site';
import { publications } from '../data/publications';
import { talks } from '../data/cv';
import { readdirSync } from 'node:fs';

// The default photo shows first; the "More Cats!" button cycles through every image in public/images/cats/.
const catPhotos = [
  site.photo,
  ...readdirSync('public/images/cats')
    .filter((f) => /\.(jpe?g|png|webp)$/i.test(f))
    .sort()
    .map((f) => `/images/cats/${f}`),
];

const selected = publications.filter((p) => p.selected).sort((a, b) => a.selected! - b.selected!);
const fmt = (d: string) => {
  const [y, m] = d.split('-');
  return m ? new Date(Number(y), Number(m) - 1).toLocaleDateString('en-US', { month: 'short', year: 'numeric' }) : y;
};
---

<Base>
  <section class="hero">
    <div class="photo-col">
      <img id="profile-photo" class="photo" src={site.photo} alt={site.photoAlt} width="176" height="176" data-photos={JSON.stringify(catPhotos)} />
      <button id="another-cat" class="another-cat" type="button" data-goatcounter-click="more-cats" data-goatcounter-title="More Cats!" hidden>
        <Icon name="refresh" size={14} />
        More Cats!
      </button>
      <script is:inline>
        // The default photo shows first; "More Cats!" swaps in a random different one.
        // Without JS the button stays hidden.
        (function () {
          var img = document.getElementById('profile-photo');
          var button = document.getElementById('another-cat');
          var photos = JSON.parse(img.dataset.photos);
          var current = img.getAttribute('src');
          function pick() {
            var options = photos.filter(function (p) { return p !== current; });
            current = options[Math.floor(Math.random() * options.length)];
            return current;
          }
          button.hidden = false;
          button.addEventListener('click', function () {
            var next = new Image();
            var src = pick();
            button.classList.add('spinning');
            next.onload = next.onerror = function () {
              img.src = src;
              button.classList.remove('spinning');
            };
            next.src = src;
          });
        })();
      </script>
    </div>
    <div class="intro">
      <h1>{site.name}</h1>
      <p class="role">{site.title}<br /><span>{site.affiliation}</span></p>
      <ul class="links">
        {
          links.map((l) => (
            <li>
              <a href={l.href} target={l.href.startsWith('http') ? '_blank' : undefined} rel="noopener">
                <Icon name={l.icon} size={16} />
                <span>{l.label}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="bio" aria-label="About">
    <p>
      I am a Ph.D. student in Computational Biology and Bioinformatics at <strong>Yale University</strong>, advised by
      <a href="https://medicine.yale.edu/profile/qingyu-chen/">Dr. Qingyu Chen</a>. I also work with <a href="https://carlosoliver.co/">Dr. Carlos Oliver</a> at
      Vanderbilt's <a href="https://www.vanderbilt.edu/ai-proteindynamics/">Center for AI in Protein Dynamics</a>.
    </p>
    <p>
      I am building <strong>AI scientists for biology and medicine</strong>: agents that run the research loop themselves and improve along
      the way through <strong>recursive self-improvement (RSI)</strong>. I also build
      <strong>bio foundation models</strong> for proteins and RNA, which give these AI scientists both biological
      knowledge and powerful tools to work with.
    </p>
    <p>
      Before Yale, I earned an M.S. in Computer Science from Vanderbilt University, where I worked with
      <a href="https://tylersnetwork.github.io/">Dr. Tyler Derr</a> and <a href="https://meilerlab.org/">Dr. Jens Meiler</a>
      on data-centric machine learning for drug discovery, and a B.S. in Statistics and Data Science from UC Santa Barbara,
      where I worked with <a href="https://sites.brown.edu/caveslab/people/eleanor-caves/">Dr. Eleanor Caves</a> on
      computer vision for biological image analysis.
    </p>
    <p class="open-to">
      I'm looking for <strong>research internships for Summer 2027</strong>.
    </p>
  </section>

  <section class="section" aria-labelledby="featured">
    <div class="section-head"><h2 id="featured">Featured Work</h2></div>
    <div class="featured">
      {
        featured.map((f) => (
          <a
            class="feature"
            href={f.href}
            target="_blank"
            rel="noopener"
            data-goatcounter-click={`${f.title} · Featured`}
            data-goatcounter-title={`Featured: ${f.title}`}
          >
            <div class="feature-fig">
              <img src={f.image} alt={f.alt} width={f.width} height={f.height} loading="lazy" />
            </div>
            <div class="feature-body">
              <h3>
                {f.title}
                <Icon name="arrow-up-right" size={16} />
              </h3>
              <p>{f.text}</p>
            </div>
          </a>
        ))
      }
    </div>
  </section>

  <section class="section" aria-labelledby="news">
    <div class="section-head"><h2 id="news">News</h2></div>
    <ul class="news">
      {
        news.map((n) => (
          <li>
            <time datetime={n.date}>{fmt(n.date)}</time>
            <p set:html={n.html} />
          </li>
        ))
      }
    </ul>
  </section>

  <section class="section" aria-labelledby="pubs">
    <div class="section-head">
      <h2 id="pubs">Selected Publications</h2>
    </div>
    {selected.map((p) => <PubItem pub={p} compact />)}
  </section>

  <section class="section" aria-labelledby="talks">
    <div class="section-head"><h2 id="talks">Talks</h2></div>
    <ul class="talks">
      {
        talks.map((t) => (
          <li>
            <span class="talk-title">{t.title}</span>
            <span class="talk-meta">
              {t.kind}, <a href={t.href}>{t.event}</a> · {t.place} · {t.date}
            </span>
          </li>
        ))
      }
    </ul>
  </section>
</Base>

<style>
  .hero {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 1.75rem;
    align-items: center;
    margin-top: 0.5rem;
  }
  .photo-col {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.6rem;
  }
  .another-cat {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    min-height: 1.9rem;
    padding: 0.25rem 0.75rem;
    border: 1px solid var(--border);
    border-radius: 999px;
    background: var(--surface);
    color: var(--muted);
    font: inherit;
    font-size: 0.8rem;
    font-weight: 500;
    cursor: pointer;
  }
  .another-cat:hover {
    color: var(--accent);
    border-color: color-mix(in srgb, var(--accent) 45%, var(--border));
  }
  .another-cat[hidden] {
    display: none;
  }
  .another-cat.spinning :global(.icon) {
    animation: spin 0.6s linear infinite;
  }
  @keyframes spin {
    to {
      transform: rotate(360deg);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .another-cat.spinning :global(.icon) {
      animation: none;
    }
  }
  .photo {
    width: 176px;
    height: 176px;
    border-radius: 50%;
    object-fit: cover;
    border: 1px solid var(--border);
    background: var(--surface);
    box-shadow: var(--shadow);
  }
  h1 {
    font-size: clamp(2rem, 5vw, 2.6rem);
    margin-bottom: 0.35rem;
  }
  .role {
    margin: 0 0 1rem;
    color: var(--muted);
    font-size: 1.02rem;
    line-height: 1.5;
  }
  .role span {
    color: var(--text);
    font-weight: 500;
  }
  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .links a {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.3rem 0.7rem;
    border: 1px solid var(--border);
    border-radius: 999px;
    background: var(--surface);
    color: var(--muted);
    font-size: 0.86rem;
    font-weight: 500;
    text-decoration: none;
  }
  .links a:hover {
    color: var(--accent);
    border-color: color-mix(in srgb, var(--accent) 45%, var(--border));
  }
  .bio {
    margin-top: 2.25rem;
    font-size: 1.04rem;
  }
  .bio p {
    margin: 0 0 1rem;
  }
  .bio .open-to {
    padding: 0.7rem 1rem;
    border-left: 3px solid var(--accent);
    border-radius: 0 var(--radius) var(--radius) 0;
    background: var(--surface);
  }
  .featured {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1rem;
  }
  .feature {
    display: flex;
    flex-direction: column;
    overflow: hidden;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--surface);
    box-shadow: var(--shadow);
    color: inherit;
    text-decoration: none;
    transition: border-color 0.15s ease;
  }
  .feature:hover {
    border-color: color-mix(in srgb, var(--accent) 45%, var(--border));
  }
  /* Figures are drawn on white, so keep a white panel in both themes. */
  .feature-fig {
    box-sizing: border-box;
    aspect-ratio: 5 / 2;
    min-height: 0;
    overflow: hidden;
    padding: 0.6rem 0.8rem;
    background: #fff;
    border-bottom: 1px solid var(--border);
  }
  .feature-fig img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }
  .feature-body {
    padding: 0.85rem 1.05rem 1rem;
  }
  .feature h3 {
    display: flex;
    align-items: center;
    gap: 0.3rem;
    margin: 0 0 0.3rem;
    font-family: var(--font-sans);
    font-size: 1rem;
    font-weight: 600;
    letter-spacing: 0;
    color: var(--accent-strong);
  }
  .feature h3 :global(.icon) {
    color: var(--faint);
  }
  .feature:hover h3 :global(.icon) {
    color: var(--accent);
  }
  .feature p {
    margin: 0;
    font-size: 0.9rem;
    line-height: 1.55;
    color: var(--muted);
  }
  @media (max-width: 720px) {
    .featured {
      grid-template-columns: 1fr;
    }
  }
  .news {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .news li {
    display: grid;
    grid-template-columns: 5.5rem 1fr;
    gap: 1rem;
    padding: 0.5rem 0;
  }
  .news time {
    color: var(--faint);
    font-size: 0.88rem;
    font-variant-numeric: tabular-nums;
    padding-top: 0.08rem;
  }
  .news p {
    margin: 0;
    font-size: 0.95rem;
  }
  .talks {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .talks li {
    display: flex;
    flex-direction: column;
  }
  .talk-title {
    font-weight: 600;
  }
  .talk-meta {
    color: var(--muted);
    font-size: 0.9rem;
  }
  @media (max-width: 560px) {
    .hero {
      grid-template-columns: 1fr;
      gap: 1.1rem;
    }
    .photo {
      width: 120px;
      height: 120px;
    }
    .photo-col {
      align-items: flex-start;
    }
    .news li {
      grid-template-columns: 1fr;
      gap: 0.1rem;
    }
  }
</style>
